---
import '../../../core/styles.css';
import { renderFooter, renderHeader } from '../../../core/render';
import { content, ctx, withBase } from '../content';

interface Props {
  title?: string;
  description?: string;
}

const { site } = content;
const { title = site.name, description = site.intro } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/png" href={withBase('/icon.png')} />
    <title>{title}</title>
  </head>
  <body>
    <Fragment set:html={renderHeader(site, ctx, '', content.events)} />
    <main id="main"><slot /></main>
    <Fragment set:html={renderFooter(site)} />
  </body>
</html>
